<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Portfólio Público</title>
    <style>
        /* Pequenos ajustes para a área de comentários no seu layout */
        .comments-container { margin-top: 20px; border-top: 1px solid var(--border); padding-top: 20px; text-align: left; }
        .comment-item { background: #f8fafc; padding: 10px; border-radius: 8px; margin-bottom: 10px; border: 1px solid #e2e8f0; }
        .comment-item strong { color: var(--primary); display: block; margin-bottom: 3px; }
        .comment-form input, .comment-form textarea { width: 100%; margin-bottom: 10px; padding: 10px; border: 1px solid var(--border); border-radius: 5px; }
        .comment-form button { background: var(--primary); color: white; cursor: pointer; border: none; padding: 10px 20px; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="menu">
        <a href="/home">Início</a> <a href="/receitas">Receitas</a> <a href="/publico">Público</a>
        <a href="/habilidades">Habilidades</a> <a href="/relatorio">Relatório</a> <a href="/logout">Sair</a>
    </div>

    <div class="container">
        <h1>Receitas dos Alunos</h1>

        <form action="/publico" method="GET" class="search-container">
            <input type="text" name="q" placeholder="Pesquisar por ingrediente ou nome..." value="<%= termoBusca %>">
            <button type="submit">Buscar</button>
        </form>

        <div style="text-align:center; margin-bottom: 40px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;">
            <a href="/publico" class="category-badge <%= !categoriaAtiva ? 'active-category' : '' %>">Todas</a>
            
            <% categorias.forEach(c => { %>
                <a href="/publico?categoria=<%= c.id %><%= termoBusca ? '&q=' + termoBusca : '' %>" 
                   class="category-badge <%= categoriaAtiva == c.id ? 'active-category' : '' %>">
                    <%= c.nome %>
                </a>
            <% }) %>
        </div>

        <div class="recipe-grid">
            <% receitas.forEach(r => { %>
                <div class="recipe-card">
                    <img src="<%= r.imagem_url ? '/uploads/' + r.imagem_url : '/img/padrao.png' %>" alt="<%= r.nome %>">
                    <span class="category-badge"><%= r.categorias %></span>
                    <h3><%= r.nome %></h3>
                    <div class="card-footer">
                        <button onclick="abrirPopup('<%= r.id %>', '<%= r.nome.replace(/'/g, "\\'") %>', '<%= r.descricao.replace(/\r?\n/g, '<br>').replace(/'/g, "\\'") %>', '<%= r.imagem_url ? '/uploads/' + r.imagem_url : '/img/padrao.png' %>', '/receitas/editar/<%= r.id %>', '<%= r.categorias %>', '<%= r.link_externo %>', '<%= JSON.stringify(r.comentarios).replace(/'/g, "\\'") %>')" 
                                style="background: none; border: none; color: var(--primary); font-weight: 600; cursor: pointer;">
                            Ver Detalhes
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div id="popupReceita" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="fecharPopup()">&times;</span>
        
        <img id="popImg" src="" style="width: 100%; height: 350px; object-fit: cover; border-radius: 12px;">

        <div class="recipe-header">
            <span id="popCategorias" class="category-badge"></span>
            <h2 id="popTitulo"></h2>
            <p id="popDesc" style="color: var(--text-muted); font-size: 1.1rem;"></p>
        </div>
        
        <div class="action-buttons">
            <a id="popLinkExterno" href="#" target="_blank" class="category-badge" style="background: #10b981; color: white; display:none; padding: 10px 15px;">Ver Referência</a>
            <a id="popLinkEdit" href="#" class="category-badge" style="background: var(--primary); color: white; padding: 10px 15px;">Editar Receita</a>
            <button onclick="fecharPopup()" style="background: #e2e8f0; color: var(--text-main); border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">Fechar</button>
        </div>

        <div class="comments-container">
            <h3 style="margin-bottom: 20px;">Comentários</h3>
            <div id="listaComentarios"></div>

            <div class="comment-form">
                <h4 style="margin-bottom: 15px;">Deixe sua opinião</h4>
                <form id="formComentario" action="" method="POST">
                    <input type="text" name="nome" placeholder="Seu nome" required>
                    <textarea name="texto" rows="3" placeholder="O que achou desta receita?" required></textarea>
                    <button type="submit">Enviar Comentário</button>
                </form>
            </div>
        </div>
    </div>
    </div>

    <script>
        function abrirPopup(id, titulo, descricao, imagem, linkEdit, categorias, linkExterno, comentariosJSON) {
            document.getElementById('popTitulo').innerText = titulo;
            document.getElementById('popDesc').innerHTML = descricao;
            document.getElementById('popImg').src = imagem;
            document.getElementById('popLinkEdit').href = linkEdit;
            document.getElementById('popCategorias').innerText = categorias || 'Geral';

            // Configura o destino do formulário de comentário com o ID da receita
            document.getElementById('formComentario').action = `/receitas/${id}/comentarios`;

            // Lógica do Link Externo
            const btnLink = document.getElementById('popLinkExterno');
            if (linkExterno && linkExterno !== 'null' && linkExterno !== '') {
                btnLink.href = linkExterno;
                btnLink.style.display = 'inline-block';
            } else {
                btnLink.style.display = 'none';
            }

            // Lógica para exibir comentários do MongoDB
            const lista = document.getElementById('listaComentarios');
            lista.innerHTML = ''; // Limpa comentários da receita anterior
            
            const comentarios = JSON.parse(comentariosJSON);

            if (comentarios.length > 0) {
                comentarios.forEach(c => {
                    const data = new Date(c.data).toLocaleDateString('pt-BR');
                    lista.innerHTML += `
                        <div class="comment-item">
                            <strong>${c.nome}</strong>
                            <p style="margin:0;">${c.texto}</p>
                            <small style="color: #94a3b8;">${data}</small>
                        </div>
                    `;
                });
            } else {
                lista.innerHTML = '<p style="color: #94a3b8;">Nenhum comentário ainda. Seja o primeiro!</p>';
            }

            document.getElementById('popupReceita').style.display = 'flex';
        }

        function fecharPopup() { document.getElementById('popupReceita').style.display = 'none'; }
    </script>
</body>
</html>
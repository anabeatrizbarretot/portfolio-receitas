<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Portfólio Público - Receitas</title>
</head>
<body>
    <nav class="menu">
        <div class="nav-links">
            <a href="/publico">Público</a>
            <a href="/relatorio">Relatório</a>

            <% if (usuario) { %>
                <a href="/home">Início</a>
                <a href="/receitas">Minhas Receitas</a>
                <a href="/habilidades">Minhas Habilidades</a>
                
                <% if (usuario.e_admin) { %>
                    <a href="/admin" class="link-admin">Painel Admin</a>
                <% } %>
            <% } %>
        </div>
        
        <div class="nav-auth">
            <% if (usuario) { %>
                <span class="user-name">Olá, <%= usuario.nome %></span>
                <a href="/logout" class="link-sair">Sair</a>
            <% } else { %>
                <a href="/login" class="link-login-btn">Login Aluno</a>
            <% } %>
        </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Explorar Receitas</h1>
            <p class="subtitle">Criações gastronômicas dos alunos de São Sebastião da Amoreira.</p>
        </header>

        <section class="search-section">
            <form action="/publico" method="GET" class="search-container">
                <input type="text" name="q" placeholder="Procurar receita..." value="<%= termoBusca %>">
                
                <select name="categoria" onchange="this.form.submit()">
                    <option value="">Todas as Categorias</option>
                    <% categorias.forEach(cat => { %>
                        <option value="<%= cat.id %>" <%= categoriaAtiva == cat.id ? 'selected' : '' %>>
                            <%= cat.nome %>
                        </option>
                    <% }) %>
                </select>
                
                <button type="submit">Buscar</button>
            </form>
        </section>

        <section class="recipe-grid">
            <% if (receitas && receitas.length > 0) { %>
                <% receitas.forEach(r => { %>
                    <div class="recipe-card public-item">
                        <div class="card-img-wrapper">
                            <img src="<%= r.imagem_url ? '/uploads/' + r.imagem_url : '/img/padrao.png' %>" alt="Foto">
                            <span class="badge-autor">Por: <%= r.autores || 'Autor Desconhecido' %></span>
                        </div>
                        <div class="card-info">
                            <span class="cat-tag"><%= r.categorias || 'Geral' %></span>
                            <h4><%= r.nome %></h4>
                            <p class="desc-preview"><%= r.descricao.substring(0, 80) %>...</p>
                            
                            <button class="btn-details" onclick="abrirPopup('<%= r.id %>')">Ver Receita Completa</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-results">
                    <p>Nenhuma receita encontrada.</p>
                    <a href="/publico">Ver todas</a>
                </div>
            <% } %>
        </section>
    </main>

    <div id="popup-receita" class="modal"></div>

    <script>
    const receitasData = <%- JSON.stringify(receitas) %>;

    function abrirPopup(id) {
        const receita = receitasData.find(r => r.id == id);
        if (!receita) return;

        const modal = document.getElementById('popup-receita');
        
        // Gera a lista de comentários em HTML
        let comentariosHTML = '';
        if (receita.comentarios && receita.comentarios.length > 0) {
            receita.comentarios.forEach(c => {
                comentariosHTML += `
                    <div class="comentario-item">
                        <strong>${c.nome}</strong>
                        <p>${c.texto}</p>
                        <small>${new Date(c.data).toLocaleDateString('pt-BR')}</small>
                    </div>
                `;
            });
        } else {
            comentariosHTML = '<p class="text-muted">Nenhum comentário ainda. Seja o primeiro!</p>';
        }

        modal.innerHTML = `
            <div class="modal-content">
                <span class="close" onclick="fecharPopup()">&times;</span>
                <img src="${receita.imagem_url ? '/uploads/' + receita.imagem_url : '/img/padrao.png'}" class="modal-img">
                <h2>${receita.nome}</h2>
                <p class="modal-cat">${receita.categorias || 'Geral'}</p>
                
                <div class="modal-desc">
                    <p>${receita.descricao.replace(/\n/g, '<br>')}</p>
                </div>

                <hr class="modal-divider">

                <div class="comments-section">
                    <h3>Comentários</h3>
                    <div class="comments-list">
                        ${comentariosHTML}
                    </div>

                    <form action="/receitas/${receita.id}/comentarios" method="POST" class="comment-form">
                        <h4>Deixe seu comentário</h4>
                        <input type="text" name="nome" placeholder="Seu nome" required>
                        <textarea name="texto" placeholder="Sua opinião sobre a receita..." required></textarea>
                        <button type="submit" class="btn-full">Enviar Comentário</button>
                    </form>
                </div>

                ${receita.link_externo ? 
                    `<a href="${receita.link_externo}" target="_blank" class="btn-full btn-external">Ver Referência Externa</a>` 
                    : ''}
            </div>
        `;
        modal.style.display = "flex";
    }

    function fecharPopup() {
        document.getElementById('popup-receita').style.display = "none";
    }

    window.onclick = function(event) {
        const modal = document.getElementById('popup-receita');
        if (event.target == modal) fecharPopup();
    }
</script>
    
</body>
</html>
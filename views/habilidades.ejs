<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Minhas Habilidades - Portfólio</title>
</head>
<body>
    <nav class="menu">
        <div class="nav-links">
            <a href="/publico">Público</a>
            <a href="/relatorio">Relatório</a>

            <% if (usuario) { %>
                <a href="/home">Início</a>
                <a href="/receitas">Minhas Receitas</a>
                <a href="/habilidades">Minhas Habilidades</a>
                
                <% if (usuario.e_admin) { %>
                    <a href="/admin" class="link-admin">Painel Admin</a>
                <% } %>
            <% } %>
        </div>
        
        <div class="nav-auth">
            <% if (usuario) { %>
                <span class="user-name">Olá, <%= usuario.nome %></span>
                <a href="/logout" class="link-sair">Sair</a>
            <% } else { %>
                <a href="/login" class="link-login-btn">Login Aluno</a>
            <% } %>
        </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Minhas Habilidades Culinárias</h1>
            <p class="subtitle">Defina o seu nível técnico nas competências do sistema.</p>
        </header>

        <section class="form-container">
            <div class="recipe-card form-skill-card">
                <h3>Atualizar Meu Nível</h3>
                <form action="/habilidades" method="POST" class="grid-form">
                    <div class="form-group">
                        <label>Selecione a Habilidade</label>
                        <select name="habilidade_id" required>
                            <option value="">-- Escolha uma competência --</option>
                            <% habilidades.forEach(hab => { %>
                                <option value="<%= hab.id %>"><%= hab.nome %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Seu Nível (Escala 0 a 10)</label>
                        <input type="number" name="nivel" min="0" max="10" placeholder="Ex: 8" required>
                    </div>

                    <button type="submit" class="btn-full btn-save">Salvar Habilidade</button>
                </form>
            </div>
        </section>

        <section class="list-container">
            <div class="recipe-grid">
                <% minhasHabilidades.forEach(minha => { %>
                    <div class="recipe-card skill-card">
                        <div class="skill-header">
                            <h4><%= minha.nome %></h4>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span class="skill-score"><%= minha.nivel %> / 10</span>
                                <a href="/habilidades/excluir/<%= minha.id %>" 
                                   onclick="return confirm('Deseja remover esta habilidade do seu perfil?')"
                                   style="text-decoration: none; color: #ef4444; font-size: 1.1rem;">🗑️</a>
                            </div>
                        </div>
                        
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" style="width: <%= minha.nivel * 10 %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Minhas Habilidades</title>
</head>
<body>
    <div class="menu">
        <a href="/home">Início</a> <a href="/receitas">Receitas</a> <a href="/publico">Público</a>
        <a href="/habilidades">Habilidades</a> <a href="/relatorio">Relatório</a>
        <% if (usuario.e_admin) { %>
            <a href="/admin" style="color: #fbbf24 !important; font-weight: bold;">Painel Admin</a>
        <% } %>
        <a href="/logout">Sair</a>
    </div>

    <div class="container">
        <h1>Minhas Habilidades Culinárias</h1>

        <form action="/habilidades" method="POST" style="max-width: 600px;">
            <h3>Atualizar Meu Nível</h3>
            <div class="form-group">
                <label>Selecione a Habilidade</label>
                <select name="habilidade_id" required>
                    <option value="">-- Escolha uma habilidade --</option>
                    <% habilidades.forEach(hab => { %>
                        <option value="<%= hab.id %>"><%= hab.nome %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label>Seu Nível (Escala 0 a 10)</label>
                <input type="number" name="nivel" min="0" max="10" placeholder="Ex: 8" required>
            </div>
            <button type="submit">Salvar Nível</button>
        </form>

        <div class="recipe-grid" style="margin-top: 40px;">
            <% minhasHabilidades.forEach(minha => { %>
                <div class="recipe-card" style="text-align: center;">
                    <h2 style="color: var(--primary);"><%= minha.nivel %>/10</h2>
                    <h4><%= minha.nome %></h4>
                    <div style="background: #eee; border-radius: 10px; height: 10px; margin-top: 10px;">
                        <div style="background: var(--primary); width: <%= minha.nivel * 10 %>%; height: 100%; border-radius: 10px;"></div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>
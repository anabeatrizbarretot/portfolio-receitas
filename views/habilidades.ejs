<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Habilidades</title>
</head>
<body>

    <div class="menu">
        <a href="/receitas">Receitas</a>
        <a href="/publico">Público</a>
        <a href="/habilidades">Habilidades</a>
        <a href="/relatorio">Relatório</a>
        <a href="/logout">Sair</a>
    </div>

    <h1>Minhas Habilidades</h1>

    <form action="/habilidades" method="POST">

        <select name="habilidade_id">

            <% habilidades.forEach(habilidade => { %>

                <option value="<%= habilidade.id %>">
                    <%= habilidade.nome %>
                </option>

            <% }) %>

        </select>

        <br><br>

        <input
            type="number"
            name="nivel"
            min="0"
            max="10"
            placeholder="Nível"
        >

        <br><br>

        <button type="submit">
            Salvar
        </button>

    </form>

    <hr>

    <% minhasHabilidades.forEach(item => { %>

        <div>

            <h3><%= item.nome %></h3>

            <p>Nível: <%= item.nivel %></p>

        </div>

        <hr>

    <% }) %>

</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><link rel="stylesheet" href="/css/style.css">
    <title>Minhas Habilidades</title>
</head>
<body>
    <div class="menu">
        <a href="/home">Início</a> 
        <a href="/receitas">Receitas</a> 
        <a href="/publico">Público</a>
        <a href="/habilidades">Habilidades</a> 
        <a href="/relatorio">Relatório</a> 
        <a href="/logout">Sair</a>
    </div>

    <div class="container">
        <h1>Minhas Habilidades</h1>
        <form action="/habilidades" method="POST">
            <div class="form-group">
                <label>Habilidade</label>
                <select name="habilidade_id">
                    <% habilidades.forEach(h => { %>
                        <option value="<%= h.id %>"><%= h.nome %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label>Nível (0 a 10)</label>
                <input type="number" name="nivel" min="0" max="10" placeholder="Ex: 8" required>
            </div>
            <button type="submit">Salvar Habilidade</button>
        </form>

        <div class="recipe-grid">
            <% minhasHabilidades.forEach(item => { %>
                <div class="recipe-card" style="padding: 20px; text-align: center;">
                    <h3 style="margin: 0;"><%= item.nome %></h3>
                    <div class="category-badge" style="background: var(--primary); color: white; margin-top: 10px;">
                        Nível: <%= item.nivel %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>
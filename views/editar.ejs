<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><link rel="stylesheet" href="/css/style.css">
    <title>Editar Receita</title>
</head>
<body>
    <div class="menu">
        <a href="/receitas">Receitas</a> <a href="/publico">Público</a> <a href="/logout">Sair</a>
    </div>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h1>Editar Receita</h1>
            <a href="/receitas" class="category-badge" style="background: #6f4e37; color: white;">← Voltar</a>
        </div>
        <form action="/receitas/editar/<%= receita.id %>" method="POST">
            <div class="form-group"><label>Nome da Receita</label>
                <input type="text" name="nome" value="<%= receita.nome %>" required></div>
            <div class="form-group"><label>Descrição</label>
                <textarea name="descricao" required><%= receita.descricao %></textarea></div>
            <div class="form-group"><label>Link Externo</label>
                <input type="text" name="link_externo" value="<%= receita.link_externo %>"></div>
            <div class="form-group"><label>Categorias</label>
                <div class="category-selection" style="display: flex; flex-wrap: wrap; gap: 10px; background: #f9f5f0; padding: 15px; border-radius: 10px;">
                    <% categorias.forEach(c => { %>
                        <label style="cursor:pointer;"><input type="checkbox" name="categorias" value="<%= c.id %>" 
                            <%= receita.categorias_ids && receita.categorias_ids.includes(c.id) ? 'checked' : '' %>> <%= c.nome %></label>
                    <% }) %>
                </div>
            </div>
            <button type="submit">Atualizar Receita</button>
        </form>
    </div>
</body>
</html>
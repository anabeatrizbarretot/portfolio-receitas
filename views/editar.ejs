<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"><link rel="stylesheet" href="/css/style.css">
    <title>Editar Receita</title>
</head>
<body>
    <div class="menu">
        <a href="/home">Início</a> <a href="/receitas">Receitas</a> <a href="/publico">Público</a>
        <a href="/habilidades">Habilidades</a> <a href="/relatorio">Relatório</a> <a href="/logout">Sair</a>
    </div>

    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h1>Editar Receita</h1>
            <a href="/receitas" class="category-badge" style="background: var(--nav-bg); color: white;">← Voltar</a>
        </div>

        <form action="/receitas/editar/<%= receita.id %>" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Nome da Receita</label>
                <input type="text" name="nome" value="<%= receita.nome %>" required>
            </div>
            <button type="submit">Atualizar Receita</button>
        </form>
    </div>
</body>
</html>
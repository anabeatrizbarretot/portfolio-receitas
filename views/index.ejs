<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Painel Principal - Portfólio de Receitas</title>
</head>
<body>
    <nav class="menu">
    <div class="nav-links">
        <a href="/publico">Público</a>
        <a href="/relatorio">Relatório</a>

        <% if (usuario) { %>
            <a href="/home">Início</a>
            <a href="/receitas">Minhas Receitas</a>
            <a href="/habilidades">Minhas Habilidades</a>
            
            <% if (usuario.e_admin) { %>
                <a href="/admin" class="link-admin">Painel Admin</a>
            <% } %>
        <% } %>
    </div>
    
    <div class="nav-auth">
        <% if (usuario) { %>
            <span class="user-name">Olá, <%= usuario.nome %></span>
            <a href="/logout" class="link-sair">Sair</a>
        <% } else { %>
            <a href="/login" class="link-login-btn">Login Aluno</a>
        <% } %>
    </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Bem-vindo ao seu Portfólio</h1>
            <p class="subtitle">O que você deseja fazer hoje?</p>
        </header>

        <section class="recipe-grid">
            <div class="recipe-card" onclick="location.href='/receitas'">
                <div class="card-icon">🍳</div>
                <h3>Gerenciar Receitas</h3>
                <p>Cadastre novas criações, edite ou exclua receitas do seu portfólio pessoal.</p>
                <span class="btn-card">Acessar</span>
            </div>

            <div class="recipe-card" onclick="location.href='/publico'">
                <div class="card-icon">🌍</div>
                <h3>Portfólio Público</h3>
                <p>Veja como as suas receitas e as de seus colegas aparecem para visitantes externos.</p>
                <span class="btn-card">Explorar</span>
            </div>

            <div class="recipe-card" onclick="location.href='/habilidades'">
                <div class="card-icon">📊</div>
                <h3>Minhas Habilidades</h3>
                <p>Atualize seu nível técnico em diferentes áreas da culinária (Escala 0-10).</p>
                <span class="btn-card">Atualizar</span>
            </div>

            <% if (usuario && usuario.e_admin) { %>
                <div class="recipe-card card-admin" onclick="location.href='/admin'">
                    <div class="card-icon">⚙️</div>
                    <h3>Painel Admin</h3>
                    <p>Gerencie alunos, categorias e as competências técnicas do sistema.</p>
                    <span class="btn-card btn-admin">Gerenciar Sistema</span>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Minhas Receitas - Portfólio</title>
</head>
<body>
    <nav class="menu">
    <div class="nav-links">
        <a href="/publico">Público</a>
        <a href="/relatorio">Relatório</a>

        <% if (usuario) { %>
            <a href="/home">Início</a>
            <a href="/receitas">Minhas Receitas</a>
            <a href="/habilidades">Minhas Habilidades</a>
            
            <% if (usuario.e_admin) { %>
                <a href="/admin" class="link-admin">Painel Admin</a>
            <% } %>
        <% } %>
    </div>
    
    <div class="nav-auth">
        <% if (usuario) { %>
            <span class="user-name">Olá, <%= usuario.nome %></span>
            <a href="/logout" class="link-sair">Sair</a>
        <% } else { %>
            <a href="/login" class="link-login-btn">Login Aluno</a>
        <% } %>
    </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Gerenciar Minhas Receitas</h1>
            <p class="subtitle">Cadastre novas receitas ou gerencie as existentes.</p>
        </header>

        <section class="form-container">
            <div class="recipe-card">
                <h3>Nova Receita</h3>
                <form action="/receitas" method="POST" enctype="multipart/form-data" class="grid-form">
                    <div class="form-group">
                        <label>Nome da Receita</label>
                        <input type="text" name="nome" required>
                    </div>

                    <div class="form-group">
                        <label>Descrição / Ingredientes</label>
                        <textarea name="descricao" rows="4" required></textarea>
                    </div>

                    <div class="form-group">
                        <label>Link Externo (YouTube/Blog)</label>
                        <input type="url" name="link_externo" placeholder="https://...">
                    </div>

                    <div class="form-group">
                        <label>Foto da Receita</label>
                        <input type="file" name="imagem" accept="image/*">
                    </div>

                    <div class="form-group">
                        <label>Categorias (N:N)</label>
                        <div class="checkbox-group">
                            <% categorias.forEach(cat => { %>
                                <label class="check-item">
                                    <input type="checkbox" name="categorias" value="<%= cat.id %>"> <%= cat.nome %>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Coautores (Outros Alunos)</label>
                        <select name="autores" multiple class="multi-select">
                            <% alunos.forEach(aluno => { %>
                                <% if (aluno.id != usuario.id) { %>
                                    <option value="<%= aluno.id %>"><%= aluno.nome %></option>
                                <% } %>
                            <% }) %>
                        </select>
                        <small>Pressione Ctrl para selecionar vários.</small>
                    </div>

                    <button type="submit" class="btn-full">Salvar Receita</button>
                </form>
            </div>
        </section>

        <section class="list-container">
            <div class="recipe-grid">
                <% receitas.forEach(r => { %>
                    <div class="recipe-card list-item">
                        <img src="<%= r.imagem_url ? '/uploads/' + r.imagem_url : '/img/padrao.png' %>" alt="Foto" class="thumb-receita">
                        <div class="card-content">
                            <h4><%= r.nome %></h4>
                            <p class="categorias-text"><%= r.categorias %></p>
                            <div class="card-actions">
                                <a href="/receitas/editar/<%= r.id %>" class="btn-edit">Editar</a>
                                <a href="/receitas/excluir/<%= r.id %>" class="btn-delete" onclick="return confirm('Excluir esta receita?')">Excluir</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Minhas Receitas</title>
</head>
<body>

    <div class="menu">
        <a href="/receitas">Receitas</a>
        <a href="/publico">Público</a>
        <a href="/habilidades">Habilidades</a>
        <a href="/relatorio">Relatório</a>
        <a href="/logout">Sair</a>
    </div>

    <div class="container">
        <h1>Cadastrar Receita</h1>

        <form action="/receitas" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Nome da Receita</label>
                <input type="text" name="nome" placeholder="Ex: Risoto de Alho Poró" required>
            </div>

            <div class="form-group">
                <label>Descrição</label>
                <textarea name="descricao" placeholder="Ingredientes e preparo..." required></textarea>
            </div>

            <div class="form-group">
                <label>Link Externo</label>
                <input type="text" name="link_externo" placeholder="Link do vídeo ou site">
            </div>

            <div class="form-group">
                <label>Foto da Receita</label>
                <input type="file" name="imagem" accept="image/*">
            </div>

            <div class="form-group">
                <label>Categorias</label>
                <div class="category-selection">
                    <% categorias.forEach(c => { %>
                        <label class="category-item">
                            <input type="checkbox" name="categorias" value="<%= c.id %>"> <%= c.nome %>
                        </label>
                    <% }) %>
                </div>
            </div>

            <button type="submit">Salvar Receita</button>
        </form>

        <hr>

        <div class="recipe-grid">
            <% receitas.forEach(r => { %>
                <div class="recipe-card">
                    <% if (r.imagem_url) { %>
                        <img src="/uploads/<%= r.imagem_url %>" alt="<%= r.nome %>">
                    <% } else { %>
                        <img src="/img/padrao.png" alt="Imagem Padrão">
                    <% } %>

                    <span class="category-badge"><%= r.categorias || 'Geral' %></span>
                    <h3><%= r.nome %></h3>
                    
                    <div class="card-footer">
                        <a href="<%= r.link_externo %>" target="_blank" class="btn-link">Ver Link</a>
                        <div class="card-actions">
                            <a href="/receitas/editar/<%= r.id %>">Editar</a>
                            <a href="/receitas/excluir/<%= r.id %>" style="color: #d32f2f;">Excluir</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Receitas</title>
</head>
<body>

    <h1>Cadastrar Receita</h1>

    <form action="/receitas" method="POST">

        <input type="text" name="nome" placeholder="Nome">

        <br><br>

        <textarea name="descricao" placeholder="Descrição"></textarea>

        <br><br>

        <input type="text" name="link_externo" placeholder="Link externo">

        <br><br>

        <button type="submit">
            Salvar
        </button>

    </form>

</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Gerenciar Alunos - Admin</title>
</head>
<body>
    <nav class="menu">
        <div class="nav-links">
            <a href="/home">Início</a>
            <a href="/receitas">Receitas</a>
            <a href="/publico">Público</a>
            <a href="/habilidades">Habilidades</a>
            <a href="/relatorio">Relatório</a>
            <% if (usuario && usuario.e_admin) { %>
                <a href="/admin" class="link-admin">Painel Admin</a>
            <% } %>
        </div>
        <div class="nav-auth">
            <span class="user-name">Olá, <%= usuario.nome %></span>
            <a href="/logout" class="link-sair">Sair</a>
        </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Gerenciar Alunos</h1>
            <p class="subtitle">Controle quem tem acesso ao sistema acadêmico.</p>
        </header>

        <section class="form-container">
            <div class="recipe-card form-admin-card">
                <h3>Cadastrar Novo Aluno</h3>
                <form action="/admin/alunos" method="POST" class="grid-form">
                    <div class="form-group">
                        <label>Nome Completo</label>
                        <input type="text" name="nome" required>
                    </div>
                    <div class="form-group">
                        <label>E-mail Acadêmico</label>
                        <input type="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label>Senha Inicial</label>
                        <input type="password" name="senha" required>
                    </div>
                    <div class="form-group-inline">
                        <input type="checkbox" name="e_admin">
                        <label>Privilégios de Administrador</label>
                    </div>
                    <button type="submit" class="btn-full">Salvar Aluno</button>
                </form>
            </div>
        </section>

        <section class="list-container">
            <div class="recipe-card">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Tipo</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% alunos.forEach(aluno => { %>
                            <tr>
                                <td><%= aluno.nome %></td>
                                <td><%= aluno.email %></td>
                                <td>
                                    <span class="category-badge <%= aluno.e_admin ? 'badge-admin' : 'badge-user' %>">
                                        <%= aluno.e_admin ? 'ADMIN' : 'ALUNO' %>
                                    </span>
                                </td>
                                <td class="table-actions">
                                    <a href="/admin/alunos/editar/<%= aluno.id %>">✏️</a>
                                    <a href="/admin/alunos/excluir/<%= aluno.id %>" onclick="return confirm('Remover aluno?')">🗑️</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
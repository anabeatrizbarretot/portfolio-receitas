<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Gerenciar Habilidades - Admin</title>
</head>
<body>
    <nav class="menu">
    <div class="nav-links">
        <a href="/publico">Público</a>
        <a href="/relatorio">Relatório</a>

        <% if (usuario) { %>
            <a href="/home">Início</a>
            <a href="/receitas">Minhas Receitas</a>
            <a href="/habilidades">Minhas Habilidades</a>
            
            <% if (usuario.e_admin) { %>
                <a href="/admin" class="link-admin">Painel Admin</a>
            <% } %>
        <% } %>
    </div>
    
    <div class="nav-auth">
        <% if (usuario) { %>
            <span class="user-name">Olá, <%= usuario.nome %></span>
            <a href="/logout" class="link-sair">Sair</a>
        <% } else { %>
            <a href="/login" class="link-login-btn">Login Aluno</a>
        <% } %>
    </div>
    </nav>
    
    <main class="container">
        <header class="main-header">
            <h1>Habilidades Técnicas</h1>
            <p class="subtitle">Catálogo de competências que os alunos podem dominar.</p>
        </header>

        <section class="form-container">
            <div class="recipe-card form-admin-card">
                <h3>Cadastrar Competência</h3>
                <form action="/admin/habilidades" method="POST" class="grid-form">
                    <div class="form-group">
                        <label>Nome da Habilidade</label>
                        <input type="text" name="nome" placeholder="Ex: Confeitaria, Parrilla" required>
                    </div>
                    <button type="submit" class="btn-full">Adicionar ao Sistema</button>
                </form>
            </div>
        </section>

        <section class="list-container">
            <div class="recipe-grid admin-skill-grid">
                <% if (habilidades && habilidades.length > 0) { %>
                    <% habilidades.forEach(hab => { %>
                        <div class="recipe-card skill-admin-item">
                            <div class="skill-info">
                                <span>👨‍🍳</span>
                                <h4><%= hab.nome %></h4>
                            </div>
                            <div class="admin-actions">
                                <a href="/admin/habilidades/editar/<%= hab.id %>">✏️</a>
                                <a href="/admin/habilidades/excluir/<%= hab.id %>" onclick="return confirm('Excluir habilidade?')">🗑️</a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-muted">Nenhuma habilidade cadastrada.</p>
                <% } %>
            </div>
        </section>
    </main>
</body>
</html>
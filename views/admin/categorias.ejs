<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Gerenciar Categorias - Admin</title>
</head>
<body>
    <nav class="menu">
    <div class="nav-links">
        <a href="/publico">Público</a>
        <a href="/relatorio">Relatório</a>

        <% if (usuario) { %>
            <a href="/home">Início</a>
            <a href="/receitas">Minhas Receitas</a>
            <a href="/habilidades">Minhas Habilidades</a>
            
            <% if (usuario.e_admin) { %>
                <a href="/admin" class="link-admin">Painel Admin</a>
            <% } %>
        <% } %>
    </div>
    
    <div class="nav-auth">
        <% if (usuario) { %>
            <span class="user-name">Olá, <%= usuario.nome %></span>
            <a href="/logout" class="link-sair">Sair</a>
        <% } else { %>
            <a href="/login" class="link-login-btn">Login Aluno</a>
        <% } %>
    </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Gerenciar Categorias</h1>
            <p class="subtitle">Adicione ou remova tipos de receitas do sistema.</p>
        </header>

        <section class="form-container">
            <div class="recipe-card form-admin-card">
                <h3>Nova Categoria</h3>
                <form action="/admin/categorias" method="POST" class="grid-form">
                    <div class="form-group">
                        <label>Nome da Categoria</label>
                        <input type="text" name="nome" placeholder="Ex: Massas, Vegana" required>
                    </div>
                    <button type="submit" class="btn-full">Cadastrar</button>
                </form>
            </div>
        </section>

        <section class="list-container">
            <div class="recipe-card">
                <h3>Categorias Cadastradas</h3>
                <div class="badge-list">
                    <% if (categorias && categorias.length > 0) { %>
                        <% categorias.forEach(cat => { %>
                            <div class="admin-badge-item">
                                <span class="category-badge"><%= cat.nome %></span>
                                <div class="admin-actions">
                                    <a href="/admin/categorias/editar/<%= cat.id %>" class="btn-icon-edit">✏️</a>
                                    <a href="/admin/categorias/excluir/<%= cat.id %>" class="btn-icon-delete" onclick="return confirm('Excluir categoria?')">🗑️</a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted">Nenhuma categoria encontrada.</p>
                    <% } %>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Painel Administrativo - Portfólio</title>
</head>
<body>
    <nav class="menu">
    <div class="nav-links">
        <a href="/publico">Público</a>
        <a href="/relatorio">Relatório</a>

        <% if (usuario) { %>
            <a href="/home">Início</a>
            <a href="/receitas">Minhas Receitas</a>
            <a href="/habilidades">Minhas Habilidades</a>
            
            <% if (usuario.e_admin) { %>
                <a href="/admin" class="link-admin">Painel Admin</a>
            <% } %>
        <% } %>
    </div>
    
    <div class="nav-auth">
        <% if (usuario) { %>
            <span class="user-name">Olá, <%= usuario.nome %></span>
            <a href="/logout" class="link-sair">Sair</a>
        <% } else { %>
            <a href="/login" class="link-login-btn">Login Aluno</a>
        <% } %>
    </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Painel do Administrador</h1>
            <p class="subtitle">Bem-vindo, <%= usuario.nome %>! O que deseja gerenciar hoje?</p>
        </header>

        <section class="recipe-grid dashboard-grid">
            <div class="recipe-card" onclick="location.href='/admin/alunos'">
                <div class="card-icon">👥</div>
                <h3>Alunos</h3>
                <p>Gerenciar cadastros, permissões e acesso dos alunos ao sistema.</p>
                <span class="btn-card">Acessar</span>
            </div>

            <div class="recipe-card" onclick="location.href='/admin/categorias'">
                <div class="card-icon">📂</div>
                <h3>Categorias</h3>
                <p>Configurar e organizar os tipos de receitas disponíveis no catálogo.</p>
                <span class="btn-card">Acessar</span>
            </div>

            <div class="recipe-card" onclick="location.href='/admin/habilidades'">
                <div class="card-icon">🏆</div>
                <h3>Habilidades</h3>
                <p>Cadastrar as competências técnicas que os alunos podem dominar.</p>
                <span class="btn-card">Acessar</span>
            </div>
        </section>
    </main>
</body>
</html>
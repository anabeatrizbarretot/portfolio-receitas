<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Relatório de Habilidades - Portfólio</title>
</head>
<body>
    <nav class="menu">
    <div class="nav-links">
        <a href="/publico">Público</a>
        <a href="/relatorio">Relatório</a>

        <% if (usuario) { %>
            <a href="/home">Início</a>
            <a href="/receitas">Minhas Receitas</a>
            <a href="/habilidades">Minhas Habilidades</a>
            
            <% if (usuario.e_admin) { %>
                <a href="/admin" class="link-admin">Painel Admin</a>
            <% } %>
        <% } %>
    </div>
    
    <div class="nav-auth">
        <% if (usuario) { %>
            <span class="user-name">Olá, <%= usuario.nome %></span>
            <a href="/logout" class="link-sair">Sair</a>
        <% } else { %>
            <a href="/login" class="link-login-btn">Login Aluno</a>
        <% } %>
    </div>
    </nav>

    <main class="container">
        <header class="main-header">
            <h1>Domínio de Habilidades</h1>
            <p class="subtitle">Proporção de alunos que dominam cada competência cadastrada.</p>
        </header>

        <section class="recipe-grid">
            <% if (habilidades && habilidades.length > 0) { %>
                <% habilidades.forEach(hab => { %>
                    <div class="recipe-card stats-card">
                        <div class="stats-header">
                            <h3><%= hab.nome %></h3>
                            <span class="stats-number"><%= hab.porcentagem %>%</span>
                        </div>
                        
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" style="width: <%= hab.porcentagem %>%"></div>
                        </div>
                        
                        <p class="stats-footer">
                            <strong><%= hab.quantidade %></strong> alunos dominam esta técnica
                        </p>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-results">
                    <p>Nenhuma habilidade cadastrada para gerar o relatório.</p>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>